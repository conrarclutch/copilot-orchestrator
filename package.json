{
  "name": "copilot-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local T3 Code orchestration core with GitHub Copilot SDK",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "start": "node bin/copilot-orchestrator.mjs",
    "test": "vitest run --config vitest.config.ts",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && tsc -p packages/chat-renderer/tsconfig.json --noEmit",
    "test:live": "node scripts/smoke-live.mjs --run-live",
    "demo": "node examples/supervise.mjs"
  },
  "bin": {
    "copilot-orchestrator": "bin/copilot-orchestrator.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.1",
    "@effect/platform-node-shared": "4.0.1",
    "@ff-labs/fff-node": "0.9.4",
    "@github/copilot-sdk": "1.0.33",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "diff": "8.0.3",
    "effect": "4.0.1",
    "jose": "6.2.2",
    "proper-lockfile": "4.1.2",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.9.0",
    "tsx": "^4.20.0",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.12.4",
    "@types/proper-lockfile": "^4.1.4",
    "@types/yauzl": "^3.4.0",
    "effect-acp": "file:test-support/effect-acp",
    "effect-codex-app-server": "file:test-support/effect-codex-app-server",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/conrarclutch/copilot-orchestrator.git"
  }
}
